{
  "name": "Question paper (pre-print check)",
  "description": "Front matter every question paper must carry before it is sent for printing. Question-level checks (numbering, options, marks, translation parity) run separately.",
  "question_checks": true,
  "elements": [
    {
      "id": "max_marks",
      "name": "Maximum marks",
      "pattern": "(max(imum)?\\.?\\s*marks?|total\\s*marks?|full\\s*marks?|पूर्णा[ंँ]?क|अधिकतम\\s*अंक|மொத்த\\s*மதிப்பெண்|அதிகபட்ச\\s*மதிப்பெண்|পূর্ণমান|કુલ\\s*ગુણ|ਕੁੱਲ\\s*ਅੰਕ|ಒಟ್ಟು\\s*ಅಂಕ|ആകെ\\s*മാർക്ക്|మొత్తం\\s*మార్కులు|ମୋଟ\\s*ନମ୍ବର)",
      "where": "first_page",
      "required": true
    },
    {
      "id": "time",
      "name": "Time allowed",
      "pattern": "(time\\s*(allowed)?\\s*[:\\-]|duration|\\bhours?\\b|समय|घंटे|நேரம்|மணி|সময়|સમય|ਸਮਾਂ|ಸಮಯ|സമയം|సమయం|ସମୟ)",
      "where": "first_page",
      "required": true
    },
    {
      "id": "instructions",
      "name": "Instructions to candidates",
      "pattern": "(instructions?|निर्देश|அறிவுரை|அறிவுறுத்தல்|নির্দেশ|સૂચના|ਹਦਾਇਤ|ಸೂಚನೆ|നിർദ്ദേശ|సూచన|ନିର୍ଦ୍ଦେଶ)",
      "where": "first_page",
      "required": true
    },
    {
      "id": "questions",
      "name": "Questions",
      "labels": [
        "first-level-question"
      ],
      "required": true
    }
  ],
  "order": [
    "max_marks",
    "instructions",
    "questions"
  ],
  "page_numbers": true
}
